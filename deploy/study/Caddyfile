{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; manifest-src 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# Matchers here run before the rewrites below, so they list public paths,
	# not document filenames only.
	@mutable path / /world /world/* /people /people/* /world.html /study /study/* /research /research/* /index.html /study-sw.js /manifest.webmanifest /study-release.json
	header @mutable Cache-Control "no-store"

	@sealedAssets path /assets/* /art/* /icons/*
	header @sealedAssets Cache-Control "public, max-age=31536000, immutable"

	route {
		@health path /healthz
		respond @health "ok" 200

		# The bare origin is the public world: a stranger who types the domain
		# gets the V5 world shell, never the research shell.
		@world path / /world /world/* /people /people/*
		rewrite @world /world.html

		# The sealed research-v4 study keeps its consent flow, its export and its
		# service worker; only its public address moved off the root.
		# `/study-sw.js` and `/study-release.json` carry a file extension and are
		# not matched here, so they stay real files.
		@study path /study /study/* /research /research/*
		rewrite @study /index.html

		# The build now also carries the V5 slice API (`dist/api/v2/*.json`, for
		# the password-protected preview in deploy/preview). This public research
		# origin does not serve it: opening slice data to the public is a separate
		# release decision, not a side effect of a rebuild.
		@sliceApi path /api /api/*
		respond @sliceApi 404

		# No SPA fallback: an unknown path is a 404, not a silent landing in
		# whichever app happens to own `index.html`.
		file_server
	}
}
